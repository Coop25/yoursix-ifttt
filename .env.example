# Copy to .env and fill in. Used by docker-compose.yml (production) and Taskfile.

# Image published by .github/workflows/release.yml
Y6IFTTT_IMAGE=ghcr.io/coop25/yoursix-ifttt:latest

# Public hostname you routed to this service in the Cloudflare Tunnel
# (Zero Trust > Networks > Tunnels > Public hostname -> http://app:8080).
Y6IFTTT_PUBLIC_URL=https://y6.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Webhook receiver ----
# YourSix does not sign webhooks, so the URL itself is the secret.
# Generate with:  openssl rand -hex 32
# The YourSix webhook URL is then  $Y6IFTTT_PUBLIC_URL/hook/$Y6IFTTT_WEBHOOK_TOKEN
Y6IFTTT_WEBHOOK_TOKEN=
# Reject requests whose User-Agent isn't "y6-platform".
Y6IFTTT_WEBHOOK_REQUIRE_USER_AGENT=true
# Reject requests not from the A record of webhook.cloud.yoursix.com
# (uses Y6IFTTT_CLIENT_IP_HEADER, set to CF-Connecting-IP in docker-compose.yml).
Y6IFTTT_WEBHOOK_VERIFY_SOURCE_IP=true

# ---- Discord login (https://discord.com/developers/applications > OAuth2) ----
# Add redirect:  $Y6IFTTT_PUBLIC_URL/auth/callback
Y6IFTTT_DISCORD_CLIENT_ID=
Y6IFTTT_DISCORD_CLIENT_SECRET=
# Optional; defaults to $Y6IFTTT_PUBLIC_URL/auth/callback
Y6IFTTT_DISCORD_REDIRECT_URL=
# At least 32 chars:  openssl rand -hex 32
Y6IFTTT_SESSION_SECRET=
Y6IFTTT_SESSION_DURATION_DAYS=14
Y6IFTTT_COOKIE_SECURE=true

# Discord user IDs (comma separated). Admins edit rules; viewers can only look.
Y6IFTTT_ADMIN_USER_IDS=
Y6IFTTT_VIEWER_USER_IDS=

# ---- Secrets ----
# Master key for the encrypted secrets manager (Secrets tab). Each admin's
# secrets are encrypted with it in the database. Without it the Secrets tab is
# disabled. Keep it out of backups of the data volume; losing it makes stored
# secrets unrecoverable (re-enter them).   openssl rand -hex 32
Y6IFTTT_SECRETS_KEY=
# Optional operator-wide secrets, usable by every admin's rules as
# {{ secret "NAME" }}. Prefer the Secrets tab for anything admin-specific.
# Y6IFTTT_SECRET_CAMERA_PASS=

# ---- Actions ----
# Default webhook for "Discord message" actions (optional).
Y6IFTTT_DISCORD_WEBHOOK_URL=

# ---- Misc ----
Y6IFTTT_EVENT_RETENTION_DAYS=30
